{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example/3d-node-editor/graph.schema.json",
  "title": "3D Node Editor Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rootGraphs",
    "enums",
    "graphs"
  ],
  "properties": {
    "rootGraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rootGraph"
      }
    },
    "enums": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/enumDefinition"
      }
    },
    "graphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/graph"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rootGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphId",
        "inputValues",
        "configurationPanel"
      ],
      "properties": {
        "graphId": {
          "$ref": "#/$defs/id"
        },
        "inputValues": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              }
            ]
          }
        },
        "configurationPanel": {
          "$ref": "#/$defs/configurationPanel"
        }
      }
    },
    "configurationPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls"
      ],
      "properties": {
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configurationControl"
          }
        }
      }
    },
    "enumDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "options"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "transformField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale",
        "origin"
      ],
      "properties": {
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "enum": ["min", "middle", "max"] },
            "y": { "enum": ["min", "middle", "max"] },
            "z": { "enum": ["min", "middle", "max"] }
          }
        }
      }
    },
    "inputDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "number"
            },
            "defaultValue": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "numberArray"
            },
            "defaultValue": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "enumId",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "enum"
            },
            "enumId": {
              "$ref": "#/$defs/id"
            },
            "defaultValue": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "color"
            },
            "defaultValue": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "boolean"
            },
            "defaultValue": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "geometry"
            }
          }
        }
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "inputs",
        "output",
        "nodes",
        "edges"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputDefinition"
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "geometry"
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "contains": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "graphOutput"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "position",
        "data"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "type": {
          "enum": [
            "primitive",
            "numberInput",
            "selector",
            "enumNumberMap",
            "color",
            "meshSelector",
            "meshAsset",
            "transform",
            "material",
            "array",
            "meshArray",
            "multiArray",
            "group",
            "sum",
            "graphInput",
            "graphOutput",
            "graphInstance"
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enumNumberMap"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mappings"
                ],
                "properties": {
                  "mappings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "enumValue",
                        "value"
                      ],
                      "properties": {
                        "enumValue": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sum"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "constant",
                  "enabled"
                ],
                "properties": {
                  "constant": {
                    "type": "number"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "graphInput"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inputId"
                ],
                "properties": {
                  "inputId": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "graphInstance"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "graphId",
                  "transform",
                  "inputValues"
                ],
                "properties": {
                  "graphId": {
                    "$ref": "#/$defs/id"
                  },
                  "transform": {
                    "$ref": "#/$defs/transformField"
                  },
                  "inputValues": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "graphOutput"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceNodeId",
        "targetNodeId",
        "sourcePort",
        "targetPort"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceNodeId": {
          "$ref": "#/$defs/id"
        },
        "targetNodeId": {
          "$ref": "#/$defs/id"
        },
        "sourcePort": {
          "$ref": "#/$defs/id"
        },
        "targetPort": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "configurationControl": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "inputId",
            "label",
            "type",
            "step"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "inputId": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "inputId",
            "label",
            "type",
            "labels",
            "total",
            "step"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "inputId": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "numberArray"
            },
            "labels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "total": {
              "type": "number",
              "minimum": 0
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "inputId",
            "label",
            "type",
            "min",
            "max",
            "step"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "inputId": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "slider"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "inputId",
            "label",
            "type"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "inputId": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "select"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "inputId",
            "label",
            "type",
            "options"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "inputId": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "color"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "inputId",
            "label",
            "type"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "inputId": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "switch"
            }
          }
        }
      ]
    }
  }
}

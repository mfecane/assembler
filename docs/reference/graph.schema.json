{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example/3d-node-editor/graph.schema.json",
  "title": "3D Node Editor Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client",
    "rootGraphs",
    "enums",
    "graphs"
  ],
  "properties": {
    "client": {
      "type": "string",
      "enum": [
        "maxshelf",
        "kitchen"
      ]
    },
    "rootGraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rootGraph"
      }
    },
    "enums": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/enumDefinition"
      }
    },
    "graphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/graph"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rootGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphId",
        "inputValues",
        "configurationPanel"
      ],
      "properties": {
        "graphId": {
          "$ref": "#/$defs/id"
        },
        "inputValues": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              {
                "$ref": "#/$defs/point3"
              }
            ]
          }
        },
        "configurationPanel": {
          "$ref": "#/$defs/configurationPanel"
        }
      }
    },
    "configurationPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls"
      ],
      "properties": {
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configurationControl"
          }
        }
      }
    },
    "enumDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "options"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "point3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "transformField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale",
        "origin"
      ],
      "properties": {
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "enum": [
                "min",
                "middle",
                "max"
              ]
            },
            "y": {
              "enum": [
                "min",
                "middle",
                "max"
              ]
            },
            "z": {
              "enum": [
                "min",
                "middle",
                "max"
              ]
            }
          }
        }
      }
    },
    "inputDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "number"
            },
            "defaultValue": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "vector3"
            },
            "defaultValue": {
              "$ref": "#/$defs/point3"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "numberArray"
            },
            "defaultValue": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "enumId",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "enum"
            },
            "enumId": {
              "$ref": "#/$defs/id"
            },
            "defaultValue": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "materialInstance"
            },
            "defaultValue": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "color"
            },
            "defaultValue": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType",
            "defaultValue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "boolean"
            },
            "defaultValue": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "geometry"
            }
          }
        }
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "inputs",
        "output",
        "nodes",
        "edges"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputDefinition"
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "valueType"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "valueType": {
              "const": "geometry"
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "contains": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "graphOutput"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "position",
        "data"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "type": {
          "enum": [
            "primitive",
            "input",
            "inputReference",
            "vector3",
            "vector3Components",
            "pin",
            "choiceToScalarMap",
            "choiceToBooleanMap",
            "choiceToVector3Map",
            "choiceToMeshMap",
            "geometryToggle",
            "meshAsset",
            "stretchableAsset",
            "transform",
            "applyMaterial",
            "array",
            "meshArray",
            "multiArray",
            "group",
            "sum",
            "mathExpression",
            "graphOutput",
            "graphInstance"
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "inputReference"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inputId"
                ],
                "properties": {
                  "inputId": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "valueType",
                  "exported"
                ],
                "properties": {
                  "valueType": {
                    "enum": [
                      "number",
                      "numberArray",
                      "vector3",
                      "enum",
                      "materialInstance",
                      "color",
                      "boolean",
                      "geometry"
                    ]
                  },
                  "value": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "$ref": "#/$defs/point3"
                      }
                    ]
                  },
                  "exported": {
                    "type": "boolean"
                  },
                  "enumId": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "applyMaterial"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stretchableAsset"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "meshId",
                  "targetSize",
                  "transform"
                ],
                "properties": {
                  "meshId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targetSize": {
                    "$ref": "#/$defs/point3"
                  },
                  "transform": {
                    "$ref": "#/$defs/transformField"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "vector3"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choiceToVector3Map"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mappings"
                ],
                "properties": {
                  "mappings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "enumIndex",
                        "value"
                      ],
                      "properties": {
                        "enumIndex": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "value": {
                          "$ref": "#/$defs/point3"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "geometryToggle"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choiceToMeshMap"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mappings"
                ],
                "properties": {
                  "mappings": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "enumIndex"
                      ],
                      "properties": {
                        "id": {
                          "allOf": [
                            {
                              "$ref": "#/$defs/id"
                            },
                            {
                              "not": {
                                "const": "enum"
                              }
                            }
                          ]
                        },
                        "enumIndex": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choiceToScalarMap"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mappings"
                ],
                "properties": {
                  "mappings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "enumIndex",
                        "value"
                      ],
                      "properties": {
                        "enumIndex": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choiceToBooleanMap"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mappings"
                ],
                "properties": {
                  "mappings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "enumIndex",
                        "value"
                      ],
                      "properties": {
                        "enumIndex": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "value": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sum"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "constant",
                  "enabled"
                ],
                "properties": {
                  "constant": {
                    "type": "number"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mathExpression"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expression"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pin"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "valueType"
                ],
                "properties": {
                  "valueType": {
                    "enum": [
                      "geometry",
                      "meshArray",
                      "number",
                      "numberArray",
                      "vector3",
                      "enum",
                      "materialInstance",
                      "color",
                      "boolean"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "graphInstance"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "graphId",
                  "transform",
                  "inputValues"
                ],
                "properties": {
                  "graphId": {
                    "$ref": "#/$defs/id"
                  },
                  "transform": {
                    "$ref": "#/$defs/transformField"
                  },
                  "inputValues": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "graphOutput"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceNodeId",
        "targetNodeId",
        "sourcePort",
        "targetPort"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceNodeId": {
          "$ref": "#/$defs/id"
        },
        "targetNodeId": {
          "$ref": "#/$defs/id"
        },
        "sourcePort": {
          "$ref": "#/$defs/id"
        },
        "targetPort": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        }
      }
    },
    "configurationControl": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "inputId",
            "label",
            "type",
            "step"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "inputId": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "inputId",
            "label",
            "type",
            "labels",
            "total",
            "step"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "inputId": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "numberArray"
            },
            "labels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "total": {
              "type": "number",
              "minimum": 0
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "inputId",
            "label",
            "type",
            "min",
            "max",
            "step"
          ],
